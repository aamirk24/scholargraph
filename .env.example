# Local/Codespaces defaults.
# Docker Compose supplies equivalent values automatically.

DATABASE_URL=postgresql+asyncpg://sguser:password@localhost:5432/scholargraph

TEST_DATABASE_URL=postgresql+asyncpg://sguser:password@localhost:5432/scholargraph_test

SECRET_KEY=replace-with-a-long-random-secret-before-production

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

ENVIRONMENT=development

ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Comma-separated email addresses allowed to run maintenance and analytics jobs.
ADMIN_EMAILS=admin@example.com

# Keep disabled unless this process is the single designated scheduler instance.
SCHEDULER_ENABLED=false

GRAPH_REFRESH_TOPICS=cs.AI

# Optional: increases Semantic Scholar API capacity when supplied.
SEMANTIC_SCHOLAR_API_KEY=
